# 🏭 **Factorio Server Konfiguration**
# Passe diese Werte nach deinen Wünschen an

# =========================
# 🔧 **Server-Informationen**
# =========================
# Server-Name
FACTORIO_SERVER_NAME=SaarlandLetsPlay Factorio

# Server-Passwort (leer lassen für öffentlichen Server)
FACTORIO_SERVER_PASSWORD=

# Server-Beschreibung
FACTORIO_SERVER_DESCRIPTION=Willkommen auf dem SaarlandLetsPlay Factorio Server!

# =========================
# 🌐 **Game-Einstellungen**
# =========================
# Spiel-Typ: normal, peaceful
FACTORIO_GAME_TYPE=normal

# Maximale Spieleranzahl
FACTORIO_MAX_PLAYERS=10

# Auto-Pause wenn keine Spieler online
FACTORIO_AUTO_PAUSE=true

# Verifikation von Spielern
FACTORIO_VERIFY_PLAYER_IDENTIFICATION=true

# =========================
# 🗺️ **Welt-Einstellungen**
# =========================
# Welt-Name
FACTORIO_WORLD_NAME=saarlandletsplay

# Welt-Seed (leer lassen für zufällig)
FACTORIO_WORLD_SEED=

# Welt-Größe: none, very-small, small, medium, large, very-large
FACTORIO_WORLD_SIZE=medium

# Wasserreich: none, low, normal, high
FACTORIO_WORLD_WATER=normal

# Ressourcen: very-poor, poor, regular, rich, very-rich
FACTORIO_WORLD_RESOURCES=regular

# Feinde: none, very-low, low, normal, high, very-high
FACTORIO_WORLD_ENEMIES=normal

# Evolution-Faktor: 0.0 bis 1.0
FACTORIO_WORLD_EVOLUTION=0.5

# =========================
# 🚀 **Technologie-Einstellungen**
# =========================
# Forschungsgeschwindigkeit: 0.1 bis 10.0
FACTORIO_TECHNOLOGY_SPEED=1.0

# Forschungskosten-Multiplikator: 0.1 bis 10.0
FACTORIO_TECHNOLOGY_COST=1.0

# =========================
# 📦 **Mod-Konfiguration**
# =========================
# Mods automatisch aktualisieren
FACTORIO_UPDATE_MODS_ON_START=true

# Mod-Pack URL (optional)
FACTORIO_MODPACK_URL=

# =========================
# 🌐 **Network-Einstellungen**
# =========================
# Game-Port
FACTORIO_PORT=34197

# RCON-Port
FACTORIO_RCON_PORT=27015

# RCON-Passwort
FACTORIO_RCON_PASSWORD=factorio_admin

# RCON aktivieren
FACTORIO_ENABLE_RCON=true

# =========================
# 📊 **Performance-Einstellungen**
# =========================
# Maximale Tick-Rate
FACTORIO_MAX_TICKS_PER_MINUTE=60

# Auto-Save Intervall (in Minuten)
FACTORIO_SAVE_INTERVAL=10

# Maximale Anzahl an Saves
FACTORIO_SAVE_COUNT=5

# =========================
# 🔧 **Admin-Einstellungen**
# =========================
# Admin-Liste (kommagetrennt)
FACTORIO_ADMINS=

# Whitelist (kommagetrennt)
FACTORIO_WHITELIST=

# Ban-Liste (kommagetrennt)
FACTORIO_BANLIST=

# =========================
# 🎮 **Spiel-Regeln**
# =========================
# Cheat-Modus
FACTORIO_CHEAT_MODE=false

# Unbegrenzte Ressourcen
FACTORIO_UNLIMITED_RESOURCES=false

# Hand-Crafting deaktivieren
FACTORIO_DISABLE_HAND_CRAFTING=false

# =========================
# 🌐 **Web-Interface**
# =========================
# Web-Modus aktivieren
FACTORIO_ENABLE_WEB=true

# Web-Port
FACTORIO_WEB_PORT=80

# =========================
# 📁 **Backup-Einstellungen**
# =========================
# Automatische Backups
FACTORIO_ENABLE_BACKUPS=true

# Backup-Intervall (in Stunden)
FACTORIO_BACKUP_INTERVAL=6

# Maximale Anzahl an Backups
FACTORIO_BACKUP_COUNT=24

# =========================
# 💾 **Resource-Limits**
# =========================
# Memory-Limit
FACTORIO_MEMORY_LIMIT=4G

# Memory-Reservation
FACTORIO_MEMORY_RESERVATION=2G

# CPU-Limit
FACTORIO_CPU_LIMIT=2.0

# CPU-Reservation
FACTORIO_CPU_RESERVATION=1.0
