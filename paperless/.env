# =========================
# Paperless-ngx
# =========================
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:latest
PAPERLESS_CONTAINER=paperless
PAPERLESS_PORT=8000

# Domain (für Links in E-Mails etc.)
PAPERLESS_URL=https://paperless.saarlandletsplay.de

# Admin-Zugangsdaten (werden beim ersten Start erstellt)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=PpL6!wN2xK8mR4vT
PAPERLESS_ADMIN_EMAIL=daniel@fam-stauder.de

# Sprache & Zeitzone
PAPERLESS_OCR_LANGUAGE=deu+eng
PAPERLESS_TIME_ZONE=Europe/Berlin

# Secret Key (zufällig, sicher halten)
PAPERLESS_SECRET_KEY=a9f3c2e8b1d7f4a0c6e9b2d5f8a1c4e7b0d3f6a9c2e5b8d1f4a7c0e3b6d9f2a

# =========================
# PostgreSQL (zentrale Instanz)
# =========================
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=postgresql
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless_db
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=PpL6!wN2xK8mR4vT

# =========================
# Redis Broker (eigene Instanz)
# =========================
PAPERLESS_REDIS=redis://paperless-redis:6379

# =========================
# Tika & Gotenberg (Dokument-Verarbeitung)
# =========================
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_ENDPOINT=http://paperless-tika:9998
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://paperless-gotenberg:3000

# =========================
# Verhalten
# =========================
PAPERLESS_CONSUMPTION_DIR=/usr/src/paperless/consume
PAPERLESS_DATA_DIR=/usr/src/paperless/data
PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media
PAPERLESS_FILENAME_FORMAT={created_year}/{correspondent}/{title}
PAPERLESS_CONSUMER_POLLING=60
PAPERLESS_OCR_MODE=skip
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=1
