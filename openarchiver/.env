# =========================
# App-Einstellungen
# =========================
NODE_ENV=production
PORT_BACKEND=4000
PORT_FRONTEND=3000
APP_URL=https://archiver.saarlandletsplay.de
ORIGIN=https://archiver.saarlandletsplay.de

# Externer Port (Host -> Container)
OA_PORT=3100

# Sync-Frequenz (Cron: jede Minute)
SYNC_FREQUENCY='* * * * *'
ALL_INCLUSIVE_ARCHIVE=false

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=open_archive
POSTGRES_USER=openarchiver
POSTGRES_PASSWORD=7307c2f8eeca20b596cf254af4463d9a
DATABASE_URL=postgresql://openarchiver:7307c2f8eeca20b596cf254af4463d9a@oa-postgres:5432/open_archive

# =========================
# Meilisearch
# =========================
MEILI_MASTER_KEY=44f76088044d1f333a03ac9abbdde7ca2935d841f07e7000f9a781b642751614
MEILI_HOST=http://oa-meilisearch:7700
MEILI_INDEXING_BATCH=500

# =========================
# Redis (Valkey)
# =========================
REDIS_HOST=oa-valkey
REDIS_PORT=6379
REDIS_PASSWORD=183571e7a2cbabc011b038ad0a307652e4c2245f9645aafd97d3d43b4f91dba8
REDIS_TLS_ENABLED=false

# =========================
# Speicher
# =========================
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=/var/data/open-archiver
BODY_SIZE_LIMIT=100M

# S3 (optional, nur wenn STORAGE_TYPE=s3)
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_REGION=
STORAGE_S3_FORCE_PATH_STYLE=false

# =========================
# Verschlüsselung & Sicherheit
# =========================
# AES-256 Encryption Key für Dateien (openssl rand -hex 32)
STORAGE_ENCRYPTION_KEY=

# JWT Secret
JWT_SECRET=44f76088044d1f333a03ac9abbdde7ca2935d841f07e7000f9a781b642751614
JWT_EXPIRES_IN=7d

# Master Encryption Key für sensible Daten (Credentials etc.)
ENCRYPTION_KEY=183571e7a2cbabc011b038ad0a307652e4c2245f9645aafd97d3d43b4f91dba8

# Löschung erlauben (true/false)
ENABLE_DELETION=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =========================
# Apache Tika (Dokumenten-Parsing)
# =========================
TIKA_URL=http://oa-tika:9998
