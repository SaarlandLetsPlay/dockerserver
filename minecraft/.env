# 🎮 **Minecraft Server Konfiguration**
# Passe diese Werte nach deinen Wünschen an

# =========================
# 📦 **Server-Typ & Version**
# =========================
# Mögliche Server-Typen: VANILLA, PAPER, PURPUR, FORGE, FABRIC, QUILT
MINECRAFT_TYPE=VANILLA

# Server-Version (z.B. 1.20.1, 1.19.4, latest, LATEST)
MINECRAFT_VERSION=1.20.1

# =========================
# 🌐 **Server-Informationen**
# =========================
SERVER_NAME=SaarlandLetsPlay Minecraft
MOTD=§6Willkommen auf dem SaarlandLetsPlay Server! §bViel Spaß!

# =========================
# 👥 **Spieler-Einstellungen**
# =========================
# Maximale Spieleranzahl
MAX_PLAYERS=20

# Schwierigkeitsgrad: peaceful, easy, normal, hard
DIFFICULTY=normal

# Spielmodus: survival, creative, adventure, spectator
GAMEMODE=survival

# PvP aktivieren (true/false)
PVP=true

# Hardcore-Modus (true/false)
HARDCORE=false

# =========================
# 💾 **Welt-Einstellungen**
# =========================
# Weltname
LEVEL_NAME=world

# Welt-Typ: DEFAULT, FLAT, LARGEBIOMES, AMPLIFIED
LEVEL_TYPE=DEFAULT

# Weltgröße (in Blöcken)
MAX_WORLD_SIZE=10000

# Sichtweite (2-32)
VIEW_DISTANCE=10

# Spawn-Schutzradius
SPAWN_PROTECTION=16

# Welt-Seed (leer lassen für zufällig)
SEED=

# =========================
# 🔧 **Performance & RAM**
# =========================
# RAM-Zuweisung (z.B. 2G, 4G, 8G, 12G)
MEMORY=4G

# =========================
# 🌍 **Online-Modus**
# =========================
# Online-Modus (true/false) - false für Cracked-Server
ONLINE_MODE=true

# Whitelist erzwingen (true/false)
ENFORCE_WHITELIST=false

# =========================
# 📡 **Network-Einstellungen**
# =========================
# Server-Port
SERVER_PORT=25565

# RCON aktivieren (true/false)
ENABLE_RCON=true
RCON_PORT=25575
RCON_PASSWORD=changeme

# Query-Protokoll für Server-Listen
ENABLE_QUERY=true
QUERY_PORT=25565

# =========================
# 🎯 **Plugin/Mod Konfiguration**
# =========================
# Für Paper/Purpur: Spigot-Plugins
# Beispiel: PLUGINS=EssentialsX,WorldEdit,WorldGuard
PLUGINS=

# Für Forge/Fabric: Mods
# Beispiel: MODS=jei-1.20.1-fabric.jar,journeymap-1.20.1-fabric.jar
MODS=

# Modpack (für CurseForge/Modrinth)
MODPACK=

# =========================
# 🗺️ **Welt-Features**
# =========================
# Strukturen generieren (true/false)
GENERATE_STRUCTURES=true

# Nether aktivieren (true/false)
ALLOW_NETHER=true

# End aktivieren (true/false)
ALLOW_END=true

# =========================
# 🎮 **Spiel-Regeln**
# =========================
# Spieler-Erfolge ankündigen (true/false)
ANNOUNCE_PLAYER_ACHIEVEMENTS=true

# Command-Bl aktivieren (true/false)
ENABLE_COMMAND_BLOCK=true

# Spielmodus erzwingen (true/false)
FORCE_GAMEMODE=false

# =========================
# 🌐 **Resource Packs**
# =========================
# Resource Pack URL
RESOURCE_PACK_URL=

# Resource Pack SHA1 (optional)
RESOURCE_PACK_SHA1=

# =========================
# 📊 **Auto-Pause (für Ressourcen-Sparen)**
# =========================
# Auto-Pause aktivieren (true/false)
ENABLE_AUTOPAUSE=false
AUTOPAUSE_TIMEOUT_EST=300
AUTOPAUSE_TIMEOUT_INIT=600
